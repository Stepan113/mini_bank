# Browser-visible configuration. Never put passwords or client secrets here.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=mini-bank
VITE_KEYCLOAK_CLIENT_ID=mini-bank-front
# Empty means same origin. Do not include /api here.
VITE_API_BASE_URL=
# Development proxy; configure production routing in Caddy/nginx.
DEV_API_TARGET=http://localhost:8080
